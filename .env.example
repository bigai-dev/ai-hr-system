# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────────

# Turso (SQLite as a service) — https://turso.tech
# After `turso db create recruit-ai`, grab the URL and a token:
#   turso db show recruit-ai --url
#   turso db tokens create recruit-ai
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Anthropic (Claude API) — https://console.anthropic.com
# Used for AI resume screening
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Vercel Blob — auto-provisioned when you add Blob via Vercel Marketplace.
# Required: resumes are stored as private blobs and streamed via /api/resumes/[id].
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# HTTP Basic Auth credentials for the dashboard (everything except /apply).
# Use a long, randomly-generated password. Rotate regularly.
# Generate one with: openssl rand -base64 32
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me-to-a-long-random-string

# Vercel Cron secret. Vercel sends this in the Authorization header to /api/cron/*.
# Auto-managed when you add a Cron in vercel.ts and deploy. Keep secret.
CRON_SECRET=change-me-to-a-long-random-string
