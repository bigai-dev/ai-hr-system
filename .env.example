# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────────

# Turso (SQLite as a service) — https://turso.tech
# After `turso db create recruit-ai`, grab the URL and a token:
#   turso db show recruit-ai --url
#   turso db tokens create recruit-ai
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# DeepSeek (OpenAI-compatible API) — https://platform.deepseek.com
# Used for AI resume screening. Model: deepseek-chat (V3).
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Vercel Blob — provision via Vercel Dashboard → your project → Storage → Create → Blob.
# Auto-injected into the project envs once connected. Resumes are stored as
# private blobs and streamed via /api/resumes/[id].
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# HTTP Basic Auth credentials for the dashboard (everything except /apply).
# Use a long, randomly-generated password. Rotate regularly.
# Generate one with: openssl rand -base64 32
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me-to-a-long-random-string

# Vercel Cron secret. Vercel sends this in the Authorization header to /api/cron/*.
# Auto-managed when you add a Cron in vercel.ts and deploy. Keep secret.
CRON_SECRET=change-me-to-a-long-random-string

# Resend (transactional email) — https://resend.com.
# Optional. If unset, the system runs in mock-log mode: emails are written to
# the `outgoing_emails` table and visible in /settings/outgoing-emails, but no
# real email is sent. This keeps demos and dev environments safe.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Recruit.AI <noreply@your-domain.com>"
EMAIL_COMPANY_NAME="The Hiring Team"

# Self-serve scheduling timezone (IANA name).
# Booking working hours (Mon-Fri 9-17) are interpreted in this zone, and
# interviews are stored as wall-clock time in this zone. Default is MYT
# (UTC+8). Change if your team operates elsewhere.
BOOKING_TIMEZONE=Asia/Kuala_Lumpur
