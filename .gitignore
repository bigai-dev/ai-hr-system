# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets. Use `.env.example` as the template.
.env*
!.env.example

# vercel
.vercel

# claude code settings (may contain tokens or local prefs)
.claude/

# uploaded resumes (PII — never commit)
/public/resumes/*

# typescript
*.tsbuildinfo
next-env.d.ts
